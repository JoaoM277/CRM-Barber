[Unit]
Description=CRM-Barber - Laravel queue worker (envio de WhatsApp)
After=network.target mysql.service

[Service]
User=www-data
WorkingDirectory=/var/www/crm-barber/backend/crm-barber
ExecStart=/usr/bin/php artisan queue:work --tries=3 --sleep=3 --max-time=3600
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
