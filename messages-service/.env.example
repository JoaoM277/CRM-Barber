# ============================================================
#  messages-service (Node.js) — variáveis de ambiente
# ============================================================

# Porta HTTP do serviço (opcional, default 3000)
PORT=3000

# ------------------------------------------------------------
#  Ponte com o backend Laravel
# ------------------------------------------------------------
# URL base da API Laravel (sem barra no final). Ex.: http://localhost:8000
API_URL_BACKEND=
# Segredo compartilhado com o Laravel (MESSAGES_SERVICE_TOKEN lá).
# Enviado no header X-Service-Token do POST /api/logs. Tem que ser IGUAL nos dois.
MESSAGES_SERVICE_TOKEN=

# ------------------------------------------------------------
#  Provedor de WhatsApp — Evolution API (único provedor)
# ------------------------------------------------------------
# URL da instância da Evolution API (com barra no final). Ex.: https://sua-evolution/
EVOLUTION_URL=
# apikey global da Evolution API
EVOLUTION_API_KEY=
