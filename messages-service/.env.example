# ============================================================
#  messages-service (Node.js) — variáveis de ambiente
# ============================================================

# Porta HTTP do serviço (opcional, default 3000)
PORT=3000

# ------------------------------------------------------------
#  Ponte com o backend Laravel
# ------------------------------------------------------------
# URL base da API Laravel (sem barra no final). Ex.: http://localhost:8000
API_URL_BACKEND=
# Token usado para autenticar as chamadas do Node no Laravel
API_TOKEN_BACKEND=

# ------------------------------------------------------------
#  Provider de WhatsApp — Evolution API
# ------------------------------------------------------------
EVOLUTION_URL=
EVOLUTION_API_KEY=

# ------------------------------------------------------------
#  Provider de SMS/WhatsApp — Infobip (legado / fallback)
# ------------------------------------------------------------
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_SENDER_ID=InfoSMS
INFOBIP_WHATSAPP_NUMBER=
