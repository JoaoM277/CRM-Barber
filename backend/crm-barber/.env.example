APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Fuso da aplicação (agenda, faturamento, "hoje"). Padrão: America/Sao_Paulo.
APP_TIMEZONE=America/Sao_Paulo

# Minutos até o token de login do painel expirar. Padrão: 43200 (30 dias).
SANCTUM_TOKEN_EXPIRATION=43200

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Em produção use "daily" (arquivo por dia, rotaciona sozinho) em vez de "single"
# (um arquivo só, cresce pra sempre). LOG_DAILY_DAYS controla quantos dias guarda.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crm_barber
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# URL do front-end estático (usada nos redirects das rotas web e no CORS)
FRONTEND_URL=http://localhost:5500
# Origens liberadas no CORS (lista separada por vírgula). Se vazio, usa FRONTEND_URL.
CORS_ALLOWED_ORIGINS=

# URL base do serviço de mensagens (Node). Precisa terminar com "/".
# Usado por ScheduleController (via job), MessageController e InstanceController.
MESSAGE_SERVICE_URL=http://localhost:3000/
# Segredo compartilhado com o serviço Node para autenticar POST /api/logs
# (o Node envia no header X-Service-Token). Gere um valor aleatório longo.
MESSAGES_SERVICE_TOKEN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
